# Copy this file to `.env` (same folder) and fill in the values for YOUR machine.
# `.env` is git-ignored, so real paths never reach GitHub. Blank = not set.

# --- Required --------------------------------------------------------------
# Folder that contains the local video mirror, organized as
# {compound}/{sex}_{subject_number}.mp4 (see PRD C11/C15 - OneDrive synced locally).
PDS_VIDEO_DIR=
# The trial database workbook (.xlsx).
PDS_DB_PATH=

# Web app address. The app has no authentication, so the host must be a loopback
# address (Docker needs the IP form). Pick ports that are free on your machine.
FISHLAB_HOST=
# Port of the link the browser opens.
FISHLAB_PORT=
# Private Python API port used only by `npm run dev` behind Vite.
FISHLAB_API_PORT=
# Frame-labeling app (`prepds annotate`).
FISHLAB_ANNOTATE_PORT=

# --- Optional (blank uses the built-in behaviour noted) ---------------------
# Folder holding the two restricted reference PNGs, used only by one-time calibration.
PDS_REFERENCE_DIR=
# Per-video working artifacts. Blank: outputs
PDS_OUTPUT_DIR=
# Accepted/gold dataset + accepted_index.parquet. Blank: accepted
PDS_ACCEPTED_DIR=
# Videos processed in parallel by `prepds run`. Blank: max(1, cpu_count - 2)
PDS_WORKERS=
# YAML file whose values override config/default_thresholds.yaml.
PDS_CONFIG=

# DCS classifier stages in ./start.sh: auto (when a checkout is found), 1 (required), 0 (off). Blank: auto
FISHLAB_DCS_ENABLED=
# DCS source checkout. Blank: the launcher looks for a sibling fish-detection-dcs-wrapup folder.
FISHLAB_DCS_ROOT=
# Trained DCS run folder. Blank: latest model under DCS_OUTPUT_DIR/training, or train one (slow).
FISHLAB_MODEL_RUN=
DCS_ACCEPTED_DIR=
DCS_PROCESSED_DIR=
DCS_OUTPUT_DIR=
DCS_DB_PATH=
DCS_TABLE=
DCS_CONFIG=

# Research chat inside the app container: 1 = on. Blank: off.
# Needs chat.model in DCS_CONFIG, FISHLAB_CHAT_URL, and a model server already running on the host.
FISHLAB_DCS_CHAT=
# Loopback URL where the DCS chat service listens. Blank: no chat bubble.
FISHLAB_CHAT_URL=
# DCS's language-model server URL (loopback). Not the same as FISHLAB_CHAT_URL.
DCS_CHAT_BASE_URL=
# Optional loopback DCS chat service (`python -m dcs serve-chat --port 8010`). Unset = no chat bubble.
# FISHLAB_CHAT_URL=
# DCS_CHAT_BASE_URL is DCS's language-model URL, not the FishLab chat-service URL.
# Compound/dose classifier (`python -m dcs`, docs/PRD.md Part II). Own DCS_* prefix:
# dcs never reads the PDS_* variables above.
# ---------------------------------------------------------------------------
# Gold dataset written by `prepds export-index` (accepted_index.parquet + one folder per video).
DCS_ACCEPTED_DIR=accepted

# Optional: the trial workbook, for the 8 NTT columns. Unset = NTT features unavailable.
# DCS_DB_PATH=data/00_NTT_DataBase.xlsx

# prepds output folder (trials_catalog.parquet + processed/<video_id>/). Read as the training
# source while training.gold_source is `processed` (unreviewed output, D-033); otherwise only
# used to cross-check the tracker.
DCS_PROCESSED_DIR=outputs

# Where dcs writes the training table, runs and models. Default: outputs/dcs
DCS_OUTPUT_DIR=outputs/dcs

# Optional: training table to read. Default: $DCS_OUTPUT_DIR/training_table.parquet
# DCS_TABLE=data/training_table.parquet

# Optional: YAML file whose values override config/default_training.yaml
# DCS_CONFIG=my_training.yaml

# ---------------------------------------------------------------------------
# Research chat (`python -m dcs ask`, `python -m dcs serve-chat`). Its address and key live
# only in your .env (or the environment); a YAML config file that sets them is refused.
# ---------------------------------------------------------------------------
# The OpenAI-compatible chat server (Ollama, llama.cpp, vLLM, ...). Example: Ollama on this machine.
DCS_CHAT_BASE_URL=http://127.0.0.1:11434/v1

# Optional: API key, only for a hosted chat server (that also needs chat.allow_remote: true in your
# DCS_CONFIG file). Put the real key in your own .env, never here: this template is committed.
# DCS_CHAT_API_KEY=
