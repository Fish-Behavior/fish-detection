# Copy this file to `.env` (same folder) and fill in the paths on YOUR machine.
# `.env` is git-ignored, so real paths never reach GitHub.
# Paths can be absolute or relative to the folder you run the pipeline from.
# On Google Colab you can instead set these with os.environ[...] before running.
# Folder that contains the trial videos (e.g. F_0001.mp4, M_0002.mp4, ...)
FISH_VIDEO_DIR=data/videos
# The trial database workbook (.xlsx)
FISH_DB_PATH=data/database.xlsx
# The reference presentation PDF with the ethogram figures (used for calibration only)
FISH_REFERENCE_PDF=data/reference.pdf
# Where all generated files go (tracks, labels, datasets, plots). Default: outputs
FISH_OUTPUT_DIR=outputs
# Number of videos processed in parallel. Default: 1
FISH_WORKERS=1
# Optional: YAML file whose values override the built-in defaults (default_config.yaml)
# FISH_CONFIG=my_settings.yaml